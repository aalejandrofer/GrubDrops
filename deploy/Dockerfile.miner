# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM node:25-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
COPY internal/i18n/locales/ /src/internal/i18n/locales/
COPY assets/img/ /src/assets/img/
RUN npm run build

FROM golang:1.26-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates

# Module download cached across builds (only re-runs when go.mod/go.sum change).
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
COPY --from=web /src/internal/web/dist ./internal/web/dist

# Release tag, injected into the binary so Settings shows the running version.
# release.yml passes VERSION=${github.ref_name}; left empty for plain builds
# (the miner then falls back to the GRUB_VERSION env var).
ARG VERSION=""

# Build the miner. The Go build cache + module cache are persisted via
# BuildKit cache mounts, so incremental rebuilds only recompile changed
# packages (template/CSS-only changes relink in seconds instead of minutes).
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${VERSION}" -o /out/grubdrops ./cmd/miner

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/grubdrops /grubdrops
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/grubdrops"]
